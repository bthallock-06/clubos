# Leave DATABASE_URL empty to run on the embedded local database (files in ./.data).
# Set it to any Postgres connection string (Neon, Supabase, RDS) to run hosted.
DATABASE_URL=

# Which adapter handles each integration slot. See src/server/integrations/registry.ts
PAYMENTS_PROVIDER=mock
ACCOUNTING_PROVIDER=csv
MEMBERSHIP_PROVIDER=manual

# Required only when PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Hosted demos only. All default to off when NODE_ENV=production.
# SEED_DEMO=true loads the demo club on deploy if the database is empty.
SEED_DEMO=false
DEMO_LOGIN=false
ALLOW_TEST_PAYMENTS=false
